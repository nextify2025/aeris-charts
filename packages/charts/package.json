{
  "name": "@aeristerminal/aeris-charts",
  "version": "0.11.0",
  "type": "module",
  "description": "Aeris all-in-one financial and general charting SDK powered by Rust and WebAssembly.",
  "license": "AGPL-3.0-only",
  "author": "Aeris Terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeristerminal/aeris-charts.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/aeristerminal/aeris-charts/issues"
  },
  "homepage": "https://github.com/aeristerminal/aeris-charts#readme",
  "keywords": [
    "aeris_charts",
    "charts",
    "charting",
    "trading",
    "aeris-charts",
    "candlestick",
    "finance",
    "market-data",
    "webgpu",
    "wasm",
    "webassembly",
    "rust"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./wasm": "./dist/aeris_charts_wasm_bg.wasm",
    "./design.css": "./dist/aeris_charts.css"
  },
  "files": [
    "dist",
    "!dist/*.js.map"
  ],
  "sideEffects": [
    "./dist/aeris_charts.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:namespace": "node scripts/namespace_guard.mjs",
    "check:api": "node scripts/api_surface.mjs",
    "update:api": "node scripts/api_surface.mjs --update",
    "check:release-gates": "node scripts/release_gate_guard.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('pkg',{recursive:true,force:true})\"",
    "build:wasm": "wasm-pack build ../../crates/aeris_charts_wasm --target web --out-dir ../../packages/charts/pkg",
    "build:js": "esbuild src/index.ts --bundle --format=esm --minify --sourcemap --loader:.svg=text --outfile=dist/index.js",
    "build:react": "esbuild src/react.ts --bundle --format=esm --minify --sourcemap --external:react --external:./index.js --outfile=dist/react.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "build:copy-wasm": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('pkg/aeris_charts_wasm_bg.wasm','dist/aeris_charts_wasm_bg.wasm')\"",
    "build:copy-design": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/aeris_charts.css','dist/aeris_charts.css')\"",
    "build": "bun run build:wasm && bun run build:js && bun run build:react && bun run build:types && bun run build:copy-wasm && bun run build:copy-design",
    "lint": "oxlint src",
    "test:react-ssr": "node -e \"import('./dist/react.js').then(m=>{if(typeof m.AerisChart!=='function')process.exit(1)})\"",
    "test:pack": "node scripts/pack_smoke.mjs",
    "prepublishOnly": "bun run clean && bun run build && bun run check:api && bun run check:namespace && bun run check:release-gates && bun run test:react-ssr && bun run test:pack"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
