{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeris_charts.com/benchmarks/result-v1.schema.json",
  "title": "Aeris Charts benchmark run",
  "type": "object",
  "required": ["schema_version", "product", "source", "build", "environment", "execution", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "const": "aeris_charts-financial" }, "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["git_commit", "git_branch", "git_tag", "dirty_worktree"],
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "git_branch": { "type": ["string", "null"] },
        "git_tag": { "type": ["string", "null"] },
        "dirty_worktree": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["profile", "logging", "build_command", "rustc_version", "wasm_pack_version", "node_version", "npm_version", "esbuild_version", "package_lock_sha256", "cargo_lock_sha256", "wasm_opt_args"],
      "properties": {
        "profile": { "enum": ["release"] },
        "logging": { "const": "default-no-verbose-debug" },
        "build_command": { "type": "string", "minLength": 1 },
        "rustc_version": { "type": ["string", "null"] },
        "wasm_pack_version": { "type": ["string", "null"] },
        "node_version": { "type": "string" },
        "npm_version": { "type": ["string", "null"] },
        "bun_version": { "type": ["string", "null"] },
        "esbuild_version": { "type": ["string", "null"] },
        "package_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "cargo_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "wasm_opt_args": { "type": "array", "items": { "type": "string" } },
        "cargo_profile": { "type": "string", "minLength": 1 },
        "wasm_opt_version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["classification", "id", "os", "os_version", "architecture", "cpu", "logical_cpu_count", "physical_cpu_count", "total_ram_bytes", "gpu", "gpu_vendor", "gpu_driver", "runtime", "runtime_version", "viewport", "device_pixel_ratio", "refresh_rate_hz"],
      "properties": {
        "classification": { "enum": ["local", "shared-ci", "official-benchmark-runner"] },
        "id": { "type": "string", "minLength": 1 },
        "os": { "type": "string" },
        "os_version": { "type": "string" },
        "architecture": { "type": "string" },
        "cpu": { "type": ["string", "null"] },
        "logical_cpu_count": { "type": "integer", "minimum": 1 },
        "physical_cpu_count": { "type": ["integer", "null"], "minimum": 1 },
        "total_ram_bytes": { "type": "integer", "minimum": 1 },
        "gpu": { "type": ["string", "null"] },
        "gpu_vendor": { "type": ["string", "null"] },
        "gpu_driver": { "type": ["string", "null"] },
        "runtime": { "type": "string" },
        "runtime_version": { "type": "string" },
        "viewport": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } },
              "additionalProperties": false
            }
          ]
        },
        "device_pixel_ratio": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "refresh_rate_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["profile", "started_at", "completed_at", "clock", "command"],
      "properties": {
        "profile": { "enum": ["smoke", "nightly", "release", "soak", "scenario"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "clock": { "const": "performance.now monotonic in browser and Node; std::time::Instant monotonic in native Rust; wall time is metadata only" },
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "version", "status", "reproduction_command", "dataset", "execution", "capabilities", "metrics"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["passed", "failed", "unsupported"] },
        "error": { "type": ["string", "null"] },
        "reproduction_command": { "type": "string", "minLength": 1 },
        "dataset": { "$ref": "#/$defs/dataset" },
        "execution": {
          "type": "object",
          "required": ["warmup_runs", "measured_runs", "benchmark_duration_ms", "sampling_method"],
          "properties": {
            "warmup_runs": { "type": "integer", "minimum": 0 },
            "measured_runs": { "type": "integer", "minimum": 0 },
            "benchmark_duration_ms": { "type": "number", "minimum": 0 },
            "sampling_method": { "type": "string", "minLength": 1 },
            "forced_gc": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "capabilities": { "type": "object" },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["availability", "unit", "direction", "visibility", "methodology", "samples", "summary"],
      "properties": {
        "availability": { "enum": ["measured", "unsupported", "not_applicable"] },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["lower_is_better", "higher_is_better", "informational"] },
        "visibility": { "enum": ["internal", "public_candidate"] },
        "methodology": { "type": "string", "minLength": 1 },
        "samples": { "type": "array", "items": { "type": "number" } },
        "summary": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/summary" }
          ]
        }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["generator_version", "seed", "data_type", "points", "series_count", "pane_count", "configuration"],
      "properties": {
        "generator_version": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "data_type": { "const": "deterministic_ohlcv" },
        "points": { "type": "integer", "minimum": 0 },
        "series_count": { "type": "integer", "minimum": 0 },
        "pane_count": { "type": "integer", "minimum": 0 },
        "configuration": { "type": "object" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["count", "min", "max", "mean", "p50", "p90", "p95", "p99", "standard_deviation"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" },
        "p50": { "type": "number" },
        "p90": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" },
        "standard_deviation": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
